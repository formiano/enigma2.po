msgid "Configure the brightness level of the front panel display for normal operation."
msgstr "Định cấu hình mức độ sáng của màn hình bảng mặt trước để hoạt động bình thường."

msgid "Configure the color of the external subtitles, alternative (normal in white, italic in yellow, bold in cyan, underscore in green), white or yellow."
msgstr "Định cấu hình màu của phụ đề bên ngoài, thay thế (bình thường bằng màu trắng, in nghiêng màu vàng, đậm màu lục lam, gạch dưới màu xanh lá cây), trắng hoặc vàng."

msgid "Configure the color of the teletext subtitles."
msgstr "Cấu hình màu của phụ đề teletext."

msgid "Configure the contrast level of the front panel display."
msgstr "Cấu hình mức độ tương phản của màn hình bảng điều khiển phía trước."

msgid "Configure the current key map file."
msgstr "Cấu hình tập tin bản đồ phím hiện thời."

msgid "Configure the cursor behavior in the channel selection list. When opening the channel selection list you can remain on the current service or already select up/down and you are able to revert the B+/B- buttons."
msgstr "Định cấu hình hành vi con trỏ trong danh sách chọn kênh. Khi mở danh sách lựa chọn kênh, bạn có thể duy trì dịch vụ hiện tại hoặc đã chọn lên / xuống và bạn có thể hoàn nguyên các nút B + / B-."

msgid "Configure the display resolution and the font used for teletext."
msgstr "Định cấu hình độ phân giải màn hình và phông chữ được sử dụng cho teletext."

msgid "Configure the duration, in minutes, before the EnergySaver timer activates."
msgstr ""
"Thiết lập thời gian, trong phút, trước khi máy tiết kiệm năng lượng kích "
"hoạt."

msgid "Configure the duration, in minutes, before the SleepTimer activates."
msgstr ""
"Thiết lập khoảng thời gian, trong phút, trước khi Thời gian ngủ bắt đầu."

msgid "Configure the end coordinate in x of the teletext display area."
msgstr "Định cấu hình tọa độ kết thúc theo x của vùng hiển thị teletext."

msgid "Configure the end coordinate in y of the teletext display area."
msgstr "Định cấu hình tọa độ cuối trong y của vùng hiển thị teletext."

msgid "Configure the first audio language (highest priority)."
msgstr "Cấu hình ngôn ngữ âm thanh đầu tiên (ưu tiên cao nhất)."

msgid "Configure the first subtitle language (highest priority)."
msgstr "Cấu hình ngôn ngữ phụ đề đầu tiên (ưu tiên cao nhất)."

msgid "Configure the font size of the subtitles."
msgstr "Cấu hình kích thước phông chữ của phụ đề."

msgid "Configure the font size relative to default size, so 1 increases by 1 point size, and -1 decreases by 1 point size."
msgstr "Định cấu hình kích thước phông chữ so với kích thước mặc định, vì vậy 1 tăng kích thước 1 điểm và -1 giảm kích thước 1 điểm."

msgid "Configure the font size relative to skin size, so 1 increases by 1 point size, and -1 decreases by 1 point size."
msgstr "Định cấu hình kích thước phông chữ tương ứng với kích thước da, vì vậy 1 tăng kích thước 1 điểm và -1 giảm kích thước 1 điểm."

msgid "Configure the fourth audio language."
msgstr "Cấu hình ngôn ngữ âm thanh thứ tư."

msgid "Configure the fourth subtitle language."
msgstr "Cấu hình ngôn ngữ phụ đề thứ tư."

msgid "Configure the function of a long press on the power button."
msgstr "Cấu hình chức năng của một nhấn lâu trên nút nguồn."

msgid "Configure the function of a short press on the power button."
msgstr "Cấu hình chức năng nhấn nhanh vào nút nguồn."

msgid "Configure the function of the < and > buttons."
msgstr "Cấu hình hàm của các nút < và >."

msgid "Configure the gateway."
msgstr "Cấu hình cổng."

msgid "Configure the hard disk drive to go to standby after the specified idle time when the box is in standby."
msgstr "Định cấu hình ổ đĩa cứng để chuyển sang chế độ chờ sau thời gian rảnh được chỉ định khi hộp ở chế độ chờ."

msgid "Configure the hard disk drive to go to standby after the specified idle time."
msgstr "Định cấu hình ổ đĩa cứng để chuyển sang chế độ chờ sau thời gian rảnh được chỉ định."

msgid "Configure the height of the TrueType font letters used for teletext."
msgstr "Định cấu hình chiều cao của các chữ cái phông chữ TrueType được sử dụng cho teletext."

msgid "Configure the horizontal alignment of the subtitles."
msgstr "Cấu hình căn chỉnh ngang của phụ đề."

msgid "Configure the initial fast forward speed. When you press the fast forward button, winding will start at this speed."
msgstr "Cấu hình tốc độ chuyển tiếp nhanh ban đầu. Khi bạn nhấn nút chuyển tiếp nhanh, cuộn dây sẽ bắt đầu ở tốc độ này."

msgid "Configure the initial rewind speed. When you press the rewind button, winding will start at this speed."
msgstr "Cấu hình tốc độ tua lại ban đầu. Khi bạn nhấn nút tua lại, cuộn dây sẽ bắt đầu ở tốc độ này."

msgid "Configure the latitude of your location."
msgstr "Định cấu hình vĩ độ của vị trí của bạn."

msgid "Configure the longitude of your location."
msgstr "Cấu hình kinh độ của vị trí của bạn."

msgid "Configure the minimum amount of disk space to be available for recordings. When the amount of space drops below this value, deleted items will be removed from the trashcan."
msgstr ""
"Cấu hình lượng không gian đĩa tối thiểu cho các đĩa thu âm. Khi số lượng "
"khoảng trống rơi bên dưới giá trị này, các mục đã xoá sẽ bị gỡ bỏ khỏi thùng "
"rác."

msgid "Configure the minimum width before showing the 'i' icon, '0' is equal to not showing the icon at all."
msgstr "Định cấu hình chiều rộng tối thiểu trước khi hiển thị biểu tượng 'i', '0' hoàn toàn không hiển thị biểu tượng."

msgid "Configure the name server (DNS)."
msgstr "Cấu hình máy chủ tên (DNS)."

msgid "Configure the netmask."
msgstr "Cấu hình netmask."

msgid "Configure the network again"
msgstr "Định cấu hình lại mạng của bạn"

msgid "Configure the number of days after which items are automatically removed from the trashcan."
msgstr "Cấu hình số ngày sau đó mà mục được gỡ bỏ tự động khỏi thùng rác."

msgid "Configure the number of days old timers are kept before they are automatically removed from the timer list."
msgstr "Định cấu hình số ngày giờ cũ được giữ trước khi chúng tự động bị xóa khỏi danh sách hẹn giờ."

msgid "Configure the number of rows shown."
msgstr "Cấu hình số lượng hàng được hiển thị."

msgid "Configure the offline decoding delay in milliseconds. The configured delay is observed at each control word parity change."
msgstr "Định cấu hình độ trễ giải mã ngoại tuyến tính bằng mili giây. Độ trễ được cấu hình được quan sát tại mỗi thay đổi chẵn lẻ từ điều khiển."

msgid "Configure the possible fast forward speeds."
msgstr "Cấu hình tốc độ chuyển tiếp nhanh có thể."

msgid "Configure the possible rewind speeds."
msgstr "Cấu hình tốc độ tua lại có thể."

msgid "Configure the primary EPG language."
msgstr "Cấu hình ngôn ngữ EPG chính."

msgid "Configure the refresh rate of the screen."
msgstr "Cấu hình tốc độ làm mới của màn hình."

msgid "Configure the screen resolution for teletext (Not all skins support full-HD teletext)."
msgstr "Định cấu hình độ phân giải màn hình cho teletext (Không phải tất cả giao diện đều hỗ trợ teletext full-HD)."

msgid "Configure the second audio language."
msgstr "Cấu hình ngôn ngữ âm thanh thứ hai."

msgid "Configure the second subtitle language."
msgstr "Cấu hình ngôn ngữ phụ đề thứ hai."

msgid "Configure the secondary EPG language."
msgstr "Cấu hình ngôn ngữ EPG thứ cấp."

msgid "Configure the skip time interval for the '1'/'3' buttons."
msgstr "Định cấu hình khoảng thời gian bỏ qua cho các nút '1' / '3'."

msgid "Configure the skip time interval for the '4'/'6' buttons."
msgstr "Định cấu hình khoảng thời gian bỏ qua cho các nút '4' / '6'."

msgid "Configure the skip time interval for the '7'/'9' buttons."
msgstr "Định cấu hình khoảng thời gian bỏ qua cho các nút '7' / '9'."

msgid "Configure the slow motion speeds."
msgstr "Cấu hình tốc độ chuyển động chậm."

msgid "Configure the source of the frontend data as shown on the infobars. 'Settings' is as stored on the settings. 'Tuner' is as reported by the tuner."
msgstr "Định cấu hình nguồn của dữ liệu lối vào như được hiển thị trên infobars. 'Cài đặt' được lưu trữ trên cài đặt. \"Bộ chỉnh tần số\" được báo cáo bởi bộ chỉnh tần số."

msgid "Configure the speed of the background deletion process. Lower speed will consume less hard disk drive performance."
msgstr "Cấu hình tốc độ của quá trình xóa nền. Tốc độ thấp hơn sẽ tiêu thụ hiệu suất ổ đĩa cứng ít hơn."

msgid "Configure the start coordinate in x of the teletext display area."
msgstr "Định cấu hình tọa độ bắt đầu trong x của vùng hiển thị teletext."

msgid "Configure the start coordinate in y of the teletext display area."
msgstr "Định cấu hình tọa độ bắt đầu trong y của vùng hiển thị teletext."

msgid "Configure the subtitle delay when timing information is not available."
msgstr "Định cấu hình độ trễ phụ đề khi thông tin thời gian không có sẵn."

msgid "Configure the third audio language."
msgstr "Cấu hình ngôn ngữ âm thanh thứ ba."

msgid "Configure the third subtitle language."
msgstr "Cấu hình ngôn ngữ phụ đề thứ ba."

msgid "Configure the transparency of the black background of graphical DVB subtitles."
msgstr "Định cấu hình độ trong suốt của nền đen của phụ đề DVB đồ họa."

msgid "Configure the transparency of the black background of subtitles."
msgstr "Cấu hình độ trong suốt của nền đen của phụ đề."

msgid "Configure the tuner mode."
msgstr "Cấu hình chế độ bắt sóng."

msgid "Configure the type of status indication icons shown in the movie list."
msgstr "Định cấu hình loại biểu tượng chỉ báo trạng thái hiển thị trong danh sách phim."

msgid "Configure the vertical position of the subtitles, measured from the bottom of the screen."
msgstr "Định cấu hình vị trí dọc của phụ đề, được đo từ dưới cùng của màn hình."

msgid "Configure the width allocated to the picon."
msgstr "Cấu hình chiều rộng được phân bổ cho picon."

msgid "Configure the width allocated to the service name."
msgstr "Định cấu hình chiều rộng được phân bổ cho tên dịch vụ."

msgid "Configure the width of the TrueType font letters used for teletext."
msgstr "Định cấu hình độ rộng của các chữ cái phông chữ TrueType được sử dụng cho teletext."

msgid "Configure this tuner using Simple or Advanced options, loop it through to another tuner, copy a configuration from another tuner or disable it."
msgstr "Định cấu hình bộ chỉnh này bằng các tùy chọn đơn giản hoặc nâng cao hoặc lặp qua bộ chỉnh này hoặc sao chép cấu hình từ bộ chỉnh khác hoặc tắt nó."

msgid "Configure to show channel names, numbers, picons or all three inside EPG."
msgstr "Định cấu hình để hiển thị tên kênh, số, picons hoặc cả ba bên trong EPG."

msgid "Configure to show the channel names, picons, or both in the EPG."
msgstr "Định cấu hình để hiển thị tên kênh, picons hoặc cả hai trong EPG."

msgid "Configure whether a bold TrueType font is used for teletext."
msgstr "Định cấu hình xem một phông chữ TrueType đậm được sử dụng cho teletext."

msgid "Configure whether a fixed font or a scalable TrueType font is used for teletext."
msgstr "Định cấu hình xem phông chữ cố định hoặc phông chữ TrueType có thể mở rộng được sử dụng cho teletext."

msgid "Configure whether another tuner from the preferred list is allocated for recordings instead of sharing a tuner that is already active receiving the same live TV channel."
msgstr "Định cấu hình xem một bộ chỉnh khác từ danh sách ưa thích có được phân bổ cho các bản ghi thay vì chia sẻ bộ chỉnh đã hoạt động khi nhận cùng một kênh truyền hình trực tiếp hay không."

msgid "Configure whether the 'recording' symbol (in the display skin and LCD skin) is visible for real recordings only or also for streaming and pseudo recordings (e.g. EPGrefresh)."
msgstr "Định cấu hình xem biểu tượng 'ghi âm (trong giao diện hiển thị và giao diện LCD) chỉ hiển thị cho các bản ghi thực hay còn cho các bản ghi phát trực tuyến và pseuso (ví dụ: EPGrefresh)."

msgid "Configure which color format should be used on the SCART output."
msgstr "Định cấu hình định dạng màu nào sẽ được sử dụng trên đầu ra SCART."

msgid "Configure which system settings to back up"
msgstr "Cấu hình thiết lập hệ thống để sao lưu"

msgid "Configure which tuner for recordings will be preferred, when more than one tuner is available."
msgstr "Định cấu hình bộ chỉnh nào cho bản ghi sẽ được ưu tiên, khi có nhiều hơn một bộ chỉnh."

msgid "Configure which tuner type will be preferred, when the same service is available on different types of tuners."
msgstr "Định cấu hình loại bộ chỉnh nào sẽ được ưu tiên, khi cùng một dịch vụ có sẵn trên các loại bộ chỉnh khác nhau."

msgid "Configure which tuner will be preferred for recordings, when more than one tuner is available. 'Disabled' would select a tuner based on preferred tuner in customize screen. 'Auto' would choose based on E2's default rules, ignoring preferred tuner in customize screen."
msgstr "Định cấu hình bộ chỉnh nào sẽ được ưu tiên cho bản ghi, khi có nhiều hơn một bộ chỉnh. 'Đã tắt' sẽ chọn bộ chỉnh tần số dựa trên bộ chỉnh ưu tiên trong màn hình tùy chỉnh. 'Tự động' sẽ chọn dựa trên các quy tắc mặc định của E2, bỏ qua bộ chỉnh ưu tiên trong màn hình tùy chỉnh."

msgid "Configure which tuner will be preferred, when more than one tuner is available. If set to 'auto' the system will give priority to the tuner having the lowest number of channels/satellites."
msgstr "Định cấu hình bộ chỉnh nào sẽ được ưu tiên, khi có nhiều hơn một bộ chỉnh. Nếu được đặt thành 'tự động', hệ thống sẽ ưu tiên cho bộ chỉnh tần số có số kênh / vệ tinh thấp nhất."

msgid "Configure your NTP server."
msgstr "Cấu hình máy chủ NTP của bạn."

msgid "Configure your internal LAN"
msgstr "Định cấu hình mạng LAN nội bộ của bạn"

msgid "Configure your network settings, and press OK to start the scan"
msgstr "Định cấu hình cài đặt mạng của bạn và nhấn OK để quét"

msgid "Configure your wireless LAN again"
msgstr "Định cấu hình lại mạng LAN không dây của bạn"

msgid "Configures which video output connector will be used."
msgstr "Định cấu hình trình kết nối đầu ra video nào sẽ được sử dụng."

