msgstr "Nhập địa chỉ IP"

msgid "Enter PIN"
msgstr "Nhập PIN"

msgid "Enter a description for this timer."
msgstr "Hãy nhập vào mô tả cho đồng hồ hẹn giờ này."

msgid "Enter a directory or process a file (play/view/edit/install/extract/run)"
msgstr ""
"Nhập thư mục hay tiến trình một tập tin ( Play/view/dit/ install/exact/run)"

msgid "Enter a name for this timer."
msgstr "Nhập tên cho đồng hồ bấm giờ này."

msgid "Enter a new name for this device."
msgstr "Nhập tên mới cho thiết bị này."

msgid "Enter if you are North or South of the equator."
msgstr "Nhập nếu bạn ở phía bắc hoặc phía nam của đường xích đạo."

msgid "Enter if you are in the East or West hemisphere."
msgstr "Nhập nếu bạn đang ở bán cầu đông hoặc tây."

msgid "Enter new directory name:"
msgstr "Nhập tên thư mục mới:"

msgid "Enter number to jump to channel"
msgstr "nhập số để nhảy đến kênh."

msgid "Enter persistent PIN code"
msgstr "Nhập mã PIN liên tục"

msgid "Enter pin code"
msgstr "Nhập mã PIN"

msgid "Enter text via an attached keyboard"
msgstr "Nhập văn bản qua bàn phím đã gắn"

msgid "Enter the FTP password of the host receiver (required for any server running openDroid 7.5 or greater)."
msgstr ""
"Hãy nhập mật khẩu FTP của máy nhận (được yêu cầu cho bất kỳ máy phục vụ nào "
"đang chạy openDero 7.5 hoặc lớn hơn)."

msgid "Enter the FTP port of the host receiver (normally '21')."
msgstr "Hãy nhập cổng FTP của máy nhận (bình thường '21)."

msgid "Enter the FTP username of the host receiver (normally 'root')."
msgstr "Hãy nhập tên người dùng FTP của người nhận (thường là 'root')."

msgid "Enter the IP address of the host receiver."
msgstr "Hãy nhập địa chỉ IP của máy nhận."

msgid "Enter the IP address of the receiver to use for fallback tuners."
msgstr ""
"Hãy nhập địa chỉ IP của bộ nhận để dùng cho bộ điều chỉnh cú pháp hậu phương."

msgid "Enter the IP address or subnet (e.g. 192.168.1.0/24) to which NFS host access is granted. Enter '*', the default, for all host access."
msgstr ""
"Hãy nhập địa chỉ IP hay subnet (v. d. 192. 1. 1. 0/ 24) mà máy NFS có quyền "
"truy cập. Nhập '*', mặc định cho mọi máy truy cập."

msgid "Enter the IP address to be used as the gateway to other networks for this adapter. Typically this is the IP address of your router."
msgstr ""
"Hãy nhập địa chỉ IP sẽ được dùng làm cổng ra các mạng khác cho người thích "
"nghi này. Thường thì đây là địa chỉ IP của bộ định tuyến."

msgid "Enter the URL/IP of the fallback remote receiver, e.g. '192.168.0.1'. The other details such as 'http://' and port number will be filled in automatically when you select save."
msgstr ""
"Hãy nhập URL/IP của bộ nhận từ xa rơi xuống, v. d. '192.1. Những chi tiết "
"khác như 'htp mỡ' và cổng sẽ được điền tự động khi bạn chọn lưu."

msgid "Enter the ZeroTier Network ID. The ID should be exactly 16 characters in length."
msgstr "Nhập mã nhận diện mạng ZeroTier. ID phải chính xác là 16 kí tự."

msgid "Enter the domain of the host receiver. Do not include 'http://' or port number."
msgstr "Nhập vào miền của máy nhận. Không bao gồm « htp » hay số cổng."

msgid "Enter the fixed/static IPv4 address to be used for this network adapter."
msgstr "Hãy nhập địa chỉ IP4 cố định cho bộ thích nghi mạng này."

msgid "Enter the frequency at which you LNB switches between low band and high band. For more information consult the specifications of your LNB."
msgstr "Nhập tần số mà LNB của bạn chuyển đổi giữa băng tần thấp và băng tần cao. Để biết thêm thông tin tham khảo bảng thông số kỹ thuật của LNB của bạn."

msgid "Enter the frequency step size for the tuner to use when searching for cable multiplexes. For more information consult your cable provider's documentation."
msgstr "Nhập kích thước bước tần số cho bộ chỉnh tần số để sử dụng khi tìm kiếm ghép kênh cáp. Để biết thêm thông tin tham khảo tài liệu của nhà cung cấp cáp của bạn."

msgid "Enter the number of NFS server threads to be allocated/used. Higher values improve performance with multiple clients but use more memory."
msgstr ""
"Hãy nhập số mạch của máy phục vụ NFS cần được phân phát/ dùng. Giá trị cao "
"hơn cải thiện hiệu suất với nhiều khách hàng nhưng sử dụng nhiều bộ nhớ hơn."

msgid "Enter the number stored in the positioner that corresponds to this satellite."
msgstr "Nhập số được lưu trong bộ định vị tương ứng với vệ tinh này."

msgid "Enter the password, pass-phrase or pre-shared key for the selected wireless network."
msgstr ""
"Hãy nhập mật khẩu, mật khẩu hoặc phím đã dùng cho mạng không dây đã chọn."

msgid "Enter the primary IPv4 DNS setting for this adapter."
msgstr "Hãy nhập thiết lập IPV4 cho bộ thích nghi này."

msgid "Enter the primary IPv6 DNS setting for this adapter. (Optional)"
msgstr "Hãy nhập thiết lập DNS chính cho bộ thích nghi này. (Tiếng vỗ)"

msgid "Enter the secondary IPv4 DNS setting for this adapter. (Optional)"
msgstr "Hãy nhập thiết lập IPv4 DNS thứ hai cho bộ thích nghi này. (Tiếng vỗ)"

msgid "Enter the secondary IPv6 DNS setting for this adapter. (Optional)"
msgstr "Hãy nhập thiết lập IPv6 DNS thứ hai cho bộ thích nghi này. (Tiếng vỗ)"

msgid "Enter the service pin"
msgstr "Nhập mã dịch vụ"

msgid "Enter the size in Megabyte of the first partition:"
msgstr "Nhập kích cỡ vào Megabyte của phân vùng đầu tiên:"

msgid "Enter the size in Megabyte of the second partition:"
msgstr "Hãy nhập vào kích cỡ của sự phân chia thứ hai:"

msgid "Enter the size in Megabyte of the third partition:"
msgstr "Hãy nhập kích cỡ vào Megabyte của phân vùng thứ ba:"

msgid "Enter the streaming port of the host receiver (normally '8001')."
msgstr "Hãy nhập cổng truyền của máy nhận (bình thường là 8001)."

msgid "Enter the subnet mask to be used for this network adapter. (e.g. 255.255.255.0)"
msgstr ""
"Hãy nhập vào đây mặt nạ mạng phụ cần dùng cho bộ thích nghi mạng này. (e.g. "
"255.255.255.5)"

msgid "Enter the subscription code to fully enable the AI-Powered Translation plugin, the unified code for trial is 15."
msgstr ""
"Hãy nhập mã đăng ký đầy đủ để hiệu lực khả năng sử dụng bổ sung phiên dịch "
"Al-Poped, mã thống nhất cho phiên tòa 15."

msgid "Enter the workgroup name to be used by this receiver for Samba based connections. (Default is 'WORKGROUP'.)"
msgstr ""
"Nhập tên nhóm làm việc cần dùng bởi bộ nhận này cho kết nối dựa trên Samba. "
"(Mặc định là 'WorKROUP'.)"

msgid "Enter your current latitude. This is the number of degrees you are from the equator as a decimal."
msgstr "Nhập vĩ độ hiện tại của bạn. Đây là số độ bạn đến từ đường xích đạo dưới dạng thập phân."

msgid "Enter your current longitude. This is the number of degrees you are from zero meridian as a decimal."
msgstr "Nhập kinh độ hiện tại của bạn. Đây là số độ bạn từ kinh tuyến bằng 0 dưới dạng thập phân."

msgid "Enter your high band local oscillator frequency. For more information consult the specifications of your LNB."
msgstr "Nhập tần số dao động cục bộ băng tần cao của bạn. Để biết thêm thông tin tham khảo bảng thông số kỹ thuật của LNB của bạn."

msgid "Enter your low band local oscillator frequency. For more information consult the specifications of your LNB."
msgstr "Nhập tần số dao động cục bộ băng tần thấp của bạn. Để biết thêm thông tin tham khảo bảng thông số kỹ thuật của LNB của bạn."

msgid "Enter your personal feed URL to allow you to select packages from your personal feed."
msgstr ""
"Hãy nhập địa chỉ URL nguồn dữ liệu cá nhân để cho bạn có khả năng chọn gói "
"từ nguồn cấp dữ liệu cá nhân."

