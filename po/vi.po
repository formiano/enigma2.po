msgstr "Chọn dịch vụ và thoát hiện thời được tô sáng"

msgid "Select the currently highlighted timer"
msgstr "Chọn đồng hồ hẹn giờ đã tô sáng"

msgid "Select the date from which this timer will become active."
msgstr "Chọn ngày mà đồng hồ hẹn giờ này sẽ hoạt động."

msgid "Select the date when this timer will activate."
msgstr "Chọn ngày khi đồng hồ hẹn giờ này sẽ được kích hoạt."

msgid "Select the date when this timer will start."
msgstr "Chọn ngày khi thời gian này bắt đầu."

msgid "Select the day of the week that this timer will activate."
msgstr "Chọn ngày trong tuần mà đồng hồ hẹn giờ này sẽ kích hoạt."

msgid "Select the default directory to be used if the left column directory is not saved."
msgstr "Chọn thư mục mặc định cần dùng nếu thư mục cột bên trái chưa được lưu."

msgid "Select the default directory to be used if the right column directory is not saved."
msgstr "Chọn thư mục mặc định cần dùng nếu chưa lưu thư mục cột đúng."

msgid "Select the delay before the timer activates."
msgstr "Chọn sự chậm trễ trước khi đồng hồ hẹn giờ kích hoạt."

msgid "Select the delay to buffer descrambled data before starting playback. This can reduce AC3 audio dropouts by ensuring enough data is available when the decoder starts. Higher values are more stable but increase channel switch time."
msgstr ""
"Chọn sự chậm trễ trong bộ đệm Điều này có thể giảm lượng âm thanh bỏ ra từ "
"AC3 bằng cách đảm bảo đủ dữ liệu sẵn có khi bộ giải mã bắt đầu. Giá trị cao "
"hơn thì ổn định hơn nhưng làm tăng thời gian chuyển đổi."

msgid "Select the delay to use when closing a Stream Relay service before reallocating the tuner for another service. Using '0' is only recommended for boxes with multiple satellite tuners."
msgstr ""
"Hãy chọn cách chậm trễ khi đóng dịch vụ phục hồi lại luồng nước trước khi "
"khởi động bộ điều chỉnh cho dịch vụ khác. Sử dụng '0' chỉ được khuyến khích "
"cho hộp có nhiều bộ điều chỉnh vệ tinh."

msgid "Select the delay to wait after pressing more digit buttons to select a new service."
msgstr ""
"Chọn sự chậm trễ cần đợi sau khi nhấn nút số nhiều hơn để chọn một dịch vụ "
"mới."

msgid "Select the delay to wait after pressing the first digit button to select a new service."
msgstr ""
"Chọn sự chậm trễ cần đợi sau khi bấm cái nút số thứ nhất để chọn một dịch vụ "
"mới."

msgid "Select the desired function and click on 'OK' to assign it. Use 'CH+/-' to toggle between the lists. Select an assigned function and click on 'OK' to deassign it. Use 'NEXT/PREVIOUS' to change the order of the assigned functions."
msgstr "Chọn chức năng mong muốn và nhấp vào \"OK\" để gán nó. Sử dụng \"CH +/-\" để chuyển đổi giữa các danh sách. Chọn một chức năng được chỉ định và nhấp vào \"OK\" để hủy gán nó. Sử dụng \"Tiếp theo / Trước\" để thay đổi thứ tự của các chức năng được gán."

msgid "Select the directory sort order for the left column:"
msgstr "Chọn thứ tự sắp xếp thư mục cho cột bên trái:"

msgid "Select the directory sort order for the right column:"
msgstr "Chọn thứ tự sắp xếp thư mục cho cột bên phải:"

msgid "Select the display design for menus."
msgstr "Chọn thiết kế hiển thị cho trình đơn."

msgid "Select the display options for each menu entry item. If menu numbers are available then the number buttons can be used to select the numbered menu entries directly."
msgstr ""
"Chọn các tùy chọn hiển thị cho mỗi mục nhập trình đơn. Nếu thực đơn sẵn "
"sàng, các nút số có thể được dùng để chọn thẳng mục nhập thực đơn đã đánh số."

msgid "Select the display sequence of previously visited services."
msgstr "Hãy chọn chuỗi hiển thị của các dịch vụ đã thăm trước."

msgid "Select the duration of inactivity before the screen saver will be displayed."
msgstr ""
"Chọn thời gian không hoạt động trước khi hiển thị trình bảo vệ màn hình."

#. TRANSLATORS: "Select the file sort order for the %s:" / the placeholder is "left column" or "right column".
#, python-format
msgid "Select the file sort order for the %s:"
msgstr "Hãy chọn thứ tự sắp xếp tập tin cho %s:"

msgid "Select the file system for the device."
msgstr "Chọn hệ thống tập tin cho thiết bị này."

msgid "Select the first item in list or move to the start of text"
msgstr "Chọn mục đầu tiên trong danh sách hoặc chuyển tới đầu văn bản"

msgid "Select the first item in the list"
msgstr "Chọn mục đầu tiên trong danh sách"

msgid "Select the function to be assigned to this button."
msgstr "Chọn hàm cần gán vào nút này."

msgid "Select the highlighted image and proceed to the slot selection"
msgstr "Chọn ảnh đã tô sáng và tiếp tục chọn khe"

msgid "Select the highlighted slot and reboot"
msgstr "Chọn khe đã tô sáng và khởi động lại"

msgid "Select the initial position of the timeline marker. The marker is the vertical line drawn on the EPG that shows the current time. The larger the value the more the marker will move to the right showing more history and less of upcoming events."
msgstr ""
"Chọn vị trí ban đầu của đánh dấu dòng thời gian. Điểm đánh dấu là đường "
"thẳng đứng được vẽ trên EPG cho thấy thời gian hiện tại. Giá trị càng lớn, "
"điểm đánh dấu sẽ di chuyển về bên phải cho thấy lịch sử nhiều hơn và ít hơn "
"của sự kiện sắp tới."

msgid "Select the input connector you want to use."
msgstr "Hãy chọn kết nối bạn muốn dùng."

msgid "Select the last item in list or move to the end of text"
msgstr "Chọn mục cuối trong danh sách hoặc chuyển tới cuối văn bản"

msgid "Select the last item in the list"
msgstr "Chọn mục cuối cùng trong danh sách"

msgid "Select the layout of the information in the services list, from the options provided by the skin, displayed within the ChannelSelection screen."
msgstr ""
"Chọn bố trí của thông tin trong danh sách dịch vụ, từ các tùy chọn do da "
"cung cấp, được hiển thị trong màn hình chọn kênh."

msgid "Select the layout of the installed plugins in the Plugin Browser screen. NOTE: The change is not immediate but will be seen when Plugin Browser is restarted!"
msgstr ""
"Chọn bố trí của bổ sung đã cài đặt trong màn hình duyệt bổ sung. GHI CHÚ: Sự "
"thay đổi này không phải ngay lập tức mà sẽ được thấy khi trình duyệt bổ sung "
"được khởi chạy lại!"

msgid "Select the list of LCN rules to be applied to the scan."
msgstr "Hãy chọn danh sách các quy tắc LCN cần áp dụng cho việc quét."

msgid "Select the locale from a menu"
msgstr "Chọn địa phương từ thực đơn"

msgid "Select the location in which to store the recording:"
msgstr "Chọn vị trí cần lưu lại:"

msgid "Select the location where the picon files will be installed."
msgstr "Ở đây hãy chọn vị trí của các tập tin ảnh sẽ được cài đặt."

msgid "Select the manufacturer of your SCR device. If the manufacturer is not listed, set 'SCR' to 'User defined' and enter the device parameters manually according to its specifications."
msgstr "Chọn nhà sản xuất thiết bị SCR của bạn. Nếu nhà sản xuất không được liệt kê, hãy đặt 'SCR' thành 'người dùng xác định' và nhập thủ công các thông số thiết bị theo bảng thông số kỹ thuật của nó."

msgid "Select the method of restoring screen resolution and framebuffer when leaving teletext."
msgstr "Chọn phương pháp khôi phục độ phân giải màn hình và bộ đệm khung khi rời teletext."

msgid "Select the mode of access, Read/Write or Read Only, applied to all automatically exported Samba shares."
msgstr ""
"Chọn chế độ truy cập, Đọc hoặc Đọc hay Đọc, được áp dụng cho mọi người tự "
"động xuất khẩu chia sẻ Samba."

msgid "Select the mode of access, Read/Write or Read Only, applied to all exported directories."
msgstr ""
"Chọn chế độ truy cập, Đọc hoặc Đọc hay Đọc, được áp dụng cho mọi thư mục "
"xuất khẩu."

msgid "Select the model number of your Unicable device. If the model number is not listed, set 'SCR' to 'User defined' and enter the device parameters manually according to its specifications."
msgstr "Chọn số kiểu máy của thiết bị Unicable của bạn. Nếu số kiểu máy không được liệt kê, hãy đặt 'SCR' thành 'người dùng xác định' và nhập thủ công các thông số thiết bị theo bảng thông số kỹ thuật của nó."

msgid "Select the mount points"
msgstr "Chọn các điểm lắp"

msgid "Select the movie path"
msgstr "Chọn đường dẫn phim"

msgid "Select the network data rate below which the timer should activate as specified. Traffic above this rate with deactivate the timer."
msgstr ""
"Hãy chọn tỷ lệ dữ liệu mạng bên dưới mà bộ hẹn giờ nên kích hoạt như đã ghi "
"rõ. Giao thông trên tỷ lệ này với việc tắt đồng hồ hẹn giờ."

msgid ""
"Select the network interface to be used for the Internet connection.\n"
"\n"
"Press OK to continue."
msgstr ""
"Chọn giao diện mạng cần dùng cho kết nối Internet.\n"
"\n"
"Nhấn OK để tiếp tục."

msgid "Select the network metric for this adapter. When multiple adapters are active, the one with the lowest network metric is used as the default route for network traffic."
msgstr ""
"Hãy chọn thước đo mạng cho bộ thích nghi này. Khi có nhiều người thích nghi "
"hoạt động, người có số đo mạng thấp nhất sẽ được dùng làm đường dẫn mặc định "
"cho giao thông mạng."

msgid "Select the network name (SSID) of the wireless network to which the receiver should connect."
msgstr "Chọn tên mạng (SSID) của mạng không dây mà người nhận nên kết nối."

#, python-format
msgid "Select the new mount point for: '%s'"
msgstr "Chọn điểm gắn kết mới cho:"

msgid "Select the next item in list or move the cursor right"
msgstr "Chọn mục kế tiếp trong danh sách hoặc di chuyển con chạy bên phải"

msgid "Select the next item in the list"
msgstr "Chọn mục kế tiếp trong danh sách"

msgid "Select the preferred service information to display, in addition to the service number, for the service selection pop up screen."
msgstr ""
"Hãy chọn những thông tin dịch vụ cần hiển thị, ngoài số dịch vụ, để chọn "
"dịch vụ bật lên màn hình."

msgid "Select the previous item in list or move the cursor left"
msgstr "Chọn mục trước trong danh sách hoặc di chuyển con chạy bên trái"

msgid "Select the previous item in the list"
msgstr "Chọn mục trước trong danh sách"

msgid "Select the previous service and close the scanner"
msgstr "Chọn dịch vụ trước và đóng máy quét"

msgid "Select the previous service and close the scanner and exit all menus"
msgstr "Chọn dịch vụ trước, đóng máy quét và thoát khỏi mọi trình đơn"

msgid "Select the protocol used by your SCR device. Choices are 'SCR Unicable' (Unicable), or 'SCR JESS' (JESS, also known as Unicable II)."
msgstr "Chọn giao thức được sử dụng bởi thiết bị SCR của bạn. Các lựa chọn là 'SCR Unicable' (Unicable) hoặc 'SCR JESS' (JESS, còn được gọi là Unicable II)."

msgid "Select the receiver action when the TV switches away from the receiver input."
msgstr "Chọn hành động nhận khi TV tắt kết nhập của bộ nhận."

msgid "Select the refresh rate to be used on the TV."
msgstr "Chọn tỷ lệ cập nhật trên TV."

msgid "Select the satellite from which your dish is receiving its signal. If you are unsure select 'Automatic' and the receiver will attempt to determine this for you."
msgstr "Chọn vệ tinh mà món ăn của bạn nhận được từ. Nếu bạn không chắc chắn, hãy chọn 'tự động' và người nhận sẽ cố gắng xác định điều này cho bạn."

msgid "Select the satellite which is connected to Port-A of your switch. If you are unsure select 'Automatic' and the receiver will attempt to determine this for you. If nothing is connected to this port, select 'Nothing connected'."
msgstr "Chọn vệ tinh được kết nối với Cổng A của công tắc. Nếu bạn không chắc chắn, hãy chọn 'tự động' và người nhận sẽ cố gắng xác định điều này cho bạn. Nếu không có gì được kết nối với cổng này, chọn 'không có gì được kết nối'."

msgid "Select the satellite which is connected to Port-B of your switch. If you are unsure select 'Automatic' and the receiver will attempt to determine this for you. If nothing is connected to this port, select 'Nothing connected'."
msgstr "Chọn vệ tinh được kết nối với Cổng B của công tắc. Nếu bạn không chắc chắn, hãy chọn 'tự động' và người nhận sẽ cố gắng xác định điều này cho bạn. Nếu không có gì được kết nối với cổng này, chọn 'không có gì được kết nối'."

msgid "Select the satellite which is connected to Port-C of your switch. If you are unsure select 'Automatic' and the receiver will attempt to determine this for you. If nothing is connected to this port, select 'Nothing connected'."
msgstr "Chọn vệ tinh được kết nối với Cổng-C của công tắc. Nếu bạn không chắc chắn, hãy chọn 'tự động' và người nhận sẽ cố gắng xác định điều này cho bạn. Nếu không có gì được kết nối với cổng này, chọn 'không có gì được kết nối'."

msgid "Select the satellite which is connected to Port-D of your switch. If you are unsure select 'Automatic' and the receiver will attempt to determine this for you. If nothing is connected to this port, select 'Nothing connected'."
msgstr "Chọn vệ tinh được kết nối với Cổng-D của công tắc. Nếu bạn không chắc chắn, hãy chọn 'tự động' và người nhận sẽ cố gắng xác định điều này cho bạn. Nếu không có gì được kết nối với cổng này, chọn 'không có gì được kết nối'."

msgid "Select the satellite you want to configure. Once configured you can select and configure other satellites that will be accessed using this same tuner."
msgstr "Chọn vệ tinh bạn muốn cấu hình. Khi vệ tinh đó được định cấu hình, bạn có thể chọn và định cấu hình các vệ tinh khác sẽ được truy cập bằng cách sử dụng cùng bộ chỉnh này."

msgid "Select the screen layout, from the options provided by the skin, to be used for the ChannelSelection screen."
msgstr ""
"Chọn bố trí màn hình, từ các tùy chọn do da cung cấp, sẽ được dùng cho màn "
"hình chọn kênh."

msgid "Select the security protocol that will be used to access the selected wireless network."
msgstr ""
"Hãy chọn giao thức bảo mật sẽ được dùng để truy cập mạng không dây đã chọn."

msgid "Select the shifted character set"
msgstr "Chọn bộ ký tự đã chuyển"

msgid "Select the shifted character set for the next character only"
msgstr "Chọn bộ ký tự đã thay đổi cho ký tự kế"

msgid "Select the size of the volume step when the VOLUME buttons are pressed."
msgstr "Chọn kích cỡ của bước âm lượng khi nhấn nút VOLUME."

msgid "Select the size of the volume steps when the VOLUME buttons are held down."
msgstr "Chọn kích cỡ của các bước âm lượng khi các nút VOLUME được giữ lại."

msgid "Select the sort order for the file lines:"
msgstr "Chọn thứ tự sắp xếp cho dòng tập tin:"

msgid "Select the sort order of the Extension Menu entries."
msgstr "Chọn thứ tự sắp xếp của mục trình đơn mở rộng."

msgid "Select the sort order of the Plugin Browser menu entries. User defined also allows the menu entries to be hidden."
msgstr ""
"Chọn thứ tự sắp xếp của mục trình duyệt bổ sung. Người dùng được định nghĩa "
"cũng cho phép ẩn mục trình đơn."

msgid "Select the sort order of the Plugin Browser menu entries. User defined also allows the plugin entries to be hidden."
msgstr ""
"Chọn thứ tự sắp xếp của mục trình duyệt bổ sung. Người dùng được định nghĩa "
"cũng cho phép ẩn mục nhập bổ sung."

msgid "Select the sort order of the menu entries. User defined also allows the menu entries to be hidden."
msgstr ""
"Chọn thứ tự sắp xếp của mục trình đơn. Người dùng được định nghĩa cũng cho "
"phép ẩn mục trình đơn."

msgid "Select the source location from where to obtain the upgrade files."
msgstr "Chọn vị trí nguồn từ đâu để có được các tập tin nâng cấp."

msgid "Select the starting/initial column to be activated on File Commander start up."
msgstr ""
"Chọn cột khởi động/ sở khởi sẽ được kích hoạt khi khởi chạy Chỉ huy Tập tin."

msgid "Select the tags that should be used for this recording."
msgstr "Hãy chọn những thẻ cần dùng cho việc ghi âm này."

msgid "Select the time after which this timer can start."
msgstr "Chọn thời gian sau đó thời gian này có thể bắt đầu."

msgid "Select the time before which this timer should end."
msgstr "Chọn thời gian trước khi thời gian này kết thúc."

msgid "Select the time delay before the button starts repeating."
msgstr "Chọn thời gian trễ trước khi nút bắt đầu lặp lại."

msgid "Select the time delay between each repeat of the button."
msgstr "Chọn thời gian trễ giữa mỗi lần lặp lại cái nút."

msgid "Select the time to which the EPG should be positioned. Press LEFT/RIGHT to decrease/increase the time by an hour. Press PREV/NEXT to decrease/increase the time by a day."
msgstr ""
"Chọn thời gian cần định vị EPG. Nhấn nút tắt/Right để giảm/làm chậm thời "
"gian trong một giờ. Nhấn nút ERV/NEXT để giảm/ngày."

msgid "Select the time when this instant recording timer should end. Press LEFT/RIGHT to decrease/increase the time by a minute. Press PREV/NEXT to decrease/increase the time by an hour."
msgstr ""
"Chọn thời gian khi thời gian ghi âm tức thời này kết thúc. Nhấn nút tắt/"
"Right để giảm/nó đang tăng dần từng phút. Nhấn nút ERV/NEXT để giảm / gia "
"tăng thời gian một giờ."

msgid "Select the time when this timer should end."
msgstr "Chọn thời gian khi thời gian này kết thúc."

msgid "Select the time when this timer will start."
msgstr "Chọn thời gian khi thời gian này bắt đầu."

msgid "Select the time zone within the area or region."
msgstr "Chọn vùng thời gian trong vùng hay vùng."

msgid "Select the timer from the fallback tuner by default"
msgstr "Khi được bật, bộ hẹn giờ từ bộ điều chỉnh dự phòng được nhập"

msgid "Select the tuner that controls the motorized dish."
msgstr "Chọn bộ chỉnh điều khiển đĩa cơ giới."

msgid "Select the tuner to which the signal cable of the SCR device is connected."
msgstr "Chọn bộ chỉnh mà cáp tín hiệu của thiết bị SCR được kết nối."

msgid "Select the tuner upon which this loop through depends."
msgstr "Chọn bộ chỉnh mà vòng lặp này phụ thuộc vào."

msgid "Select the type of LNB/device being used (normally 'Universal'). If your LNB type is not available select 'User defined'."
msgstr "Chọn loại LNB / thiết bị đang được sử dụng (thông thường là 'Phổ quát'). Nếu loại LNB của bạn không khả dụng, hãy chọn 'người dùng xác định'."

msgid "Select the type of Single Cable Reception device you are using."
msgstr "Chọn loại thiết bị Tiếp nhận cáp đơn bạn đang sử dụng."

msgid "Select the type of keyboard connected to the %s %s."
msgstr "Chọn kiểu bàn phím được kết nối đến %s %s."

msgid "Select the type of shutdown desired when the EnergySaver timer activates."
msgstr ""
"Hãy chọn kiểu tắt máy tiết kiệm năng lượng khi bộ tiết kiệm năng lượng kích "
"hoạt."

